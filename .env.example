KANBOARD_URL="https://dedikanban.dedimetri.com/jsonrpc.php"

# Authentication Priority / Bağlantı Önceliği:
# 1. User API Token (Personal Token / Kişisel Token):
#    If KANBOARD_USER_API_TOKEN is provided, connects using auth=(login_user, KANBOARD_USER_API_TOKEN)
#    Eğer KANBOARD_USER_API_TOKEN verilmişse, auth=(login_user, KANBOARD_USER_API_TOKEN) ile bağlanır.
# 2. App API Token (Global System Token / Genel Sistem Tokenı):
#    If KANBOARD_APP_API_TOKEN is provided, connects using auth=(KANBOARD_APP_USERNAME, KANBOARD_APP_API_TOKEN)
#    Eğer KANBOARD_APP_API_TOKEN verilmişse, auth=(KANBOARD_APP_USERNAME, KANBOARD_APP_API_TOKEN) ile bağlanır.
#    WARNING/UYARI: App API token does not support user-specific "My" endpoints like getMyProjects!
#                   Bu genel token 'getMyProjects' gibi kullanıcıya özel işlevleri desteklemez!
# 3. Password (Parola):
#    If both tokens are empty, connects using auth=(login_user, KANBOARD_PASSWORD)
#    Her iki token de boşsa, auth=(login_user, KANBOARD_PASSWORD) ile bağlanır.

# --- User Credentials (Kullanıcı Bilgileri) ---
KANBOARD_USERNAME="username"
KANBOARD_USERMAIL=""
KANBOARD_PASSWORD="secret_password"
KANBOARD_USER_API_TOKEN=""

# --- Application API Credentials (Uygulama Genel Bilgileri) ---
KANBOARD_APP_USERNAME="jsonrpc"
KANBOARD_APP_API_TOKEN=""
