KANBOARD_URL="https://dedikanban.dedimetri.com/jsonrpc.php"

# Choose how to connect to Kanboard:
# Kanboard'a nasıl bağlanılacağını seçin:

# Option 1: Connect via Username (or e-mail) and Password
# Seçenek 1: Kullanıcı adı (veya e-posta) ve Parola ile bağlanma
KANBOARD_USERNAME="username"
KANBOARD_USERMAIL="user_email@example.com"
KANBOARD_PASSWORD="secret_password"

# Option 2: Connect via API Token (Personal API Token under User profile or System API Token)
# If KANBOARD_API_TOKEN is provided, the system uses this instead of the password.
# Seçenek 2: API Token ile bağlanma (Kullanıcı profili altındaki Kişisel API Token veya Sistem API Token)
# Eğer KANBOARD_API_TOKEN doluysa, sistem parola yerine bunu kullanır.
KANBOARD_API_TOKEN=""
# Alternative: KANBOARD_PASSWORD=password
# Alternatif: KANBOARD_PASSWORD=parola
