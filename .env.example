KANBOARD_URL="https://your-kanboard-server.com/jsonrpc.php"

# Authentication Priority / Bağlantı Önceliği:
# 1. User API Token (Personal Token)
# 2. App API Token (Global System Token)
# 3. Password

# --- User Credentials ---
KANBOARD_USERNAME="admin"
KANBOARD_USERMAIL="admin@example.com"
KANBOARD_PASSWORD="your_password_here"
KANBOARD_USER_API_TOKEN="your_personal_token_here"

# --- Application API Credentials ---
KANBOARD_APP_USERNAME="jsonrpc"
KANBOARD_APP_API_TOKEN="your_app_token_here"
