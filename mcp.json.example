{
  "mcpServers": {
    "kanboard": {
      "command": "python",
      "args": ["kanboard_mcp_server.py"],
      "env": {
        "KANBOARD_URL": "https://your-kanboard-server.com/jsonrpc.php",
        "KANBOARD_USERMAIL": "user@example.com",
        "KANBOARD_USER_API_TOKEN": "your_personal_token_here"
      }
    }
  }
}
