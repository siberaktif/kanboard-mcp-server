{
  "mcpServers": {
    "kanboard-local": {
      "command": "/home/sencarto/dediaiproje/dedisoft/kanboard-api-python/venv/bin/python",
      "args": [
        "/home/sencarto/dediaiproje/dedisoft/kanboard-api-python/kanboard_mcp_server.py"
      ],
      "env": {
        "KANBOARD_URL": "https://www.kanboard.com.tr/kanboard/jsonrpc.php",
        "KANBOARD_USERNAME": "your_username",
        "KANBOARD_USER_API_TOKEN": "your_personal_api_token"
      }
    }
  }
}
